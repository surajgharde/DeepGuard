# Copy to .env and adjust as needed. All values below are the defaults.

# Which inference implementation to load: "mock" or "real"
DEEPGUARD_PIPELINE=mock

# SQLAlchemy URL for the jobs/results database
DEEPGUARD_DATABASE_URL=sqlite:///./deepguard.db

# Public base URL of this API. Used to build absolute image/video URLs
# returned to the frontend, so nothing is hardcoded client-side.
DEEPGUARD_PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
DEEPGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limits
DEEPGUARD_MAX_UPLOAD_MB=100

# Storage locations (relative paths resolve against the backend/ folder)
DEEPGUARD_UPLOAD_DIR=uploads
DEEPGUARD_OUTPUT_DIR=outputs

# Insert 5 demo history rows on first startup
DEEPGUARD_SEED_ON_STARTUP=true
