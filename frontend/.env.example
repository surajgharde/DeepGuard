# Copy to .env.local. These are the defaults used by the app.

# Base URL of the DeepGuard FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# How often the result page polls GET /api/jobs/{id} while a job runs (ms)
NEXT_PUBLIC_POLL_INTERVAL_MS=2000

# Client-side upload guard; keep in sync with DEEPGUARD_MAX_UPLOAD_MB
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Accepted file extensions, comma separated
NEXT_PUBLIC_ALLOWED_EXTENSIONS=.mp4,.avi,.mov
